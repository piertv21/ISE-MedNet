MAS mednet_jade {

    infrastructure: Jade

    environment: mednet.env.MedNetEnv("seed=42", "scenario=default", "gui", "probeLog")

    agents:
        control_center at "main";

        ambulance_a1 ambulance.asl at "main";
        ambulance_a2 ambulance.asl at "main";
        ambulance_a3 ambulance.asl at "main";

        patient1 patient.asl at "main";
        patient2 patient.asl at "main";
        patient3 patient.asl at "main";
        patient4 patient.asl at "main";
        patient5 patient.asl at "main";

        hospital_h1 hospital.asl at "container_h1";
        triage_nurse_h1 triage_nurse.asl at "container_h1";
        doctor_h1_cardiology doctor.asl at "container_h1";
        doctor_h1_general doctor.asl at "container_h1";
        equipment_manager_h1 equipment_manager.asl at "container_h1";

        hospital_h2 hospital.asl at "container_h2";
        triage_nurse_h2 triage_nurse.asl at "container_h2";
        doctor_h2_neurology doctor.asl at "container_h2";
        doctor_h2_general doctor.asl at "container_h2";
        equipment_manager_h2 equipment_manager.asl at "container_h2";

        hospital_h3 hospital.asl at "container_h3";
        triage_nurse_h3 triage_nurse.asl at "container_h3";
        doctor_h3_trauma_surgery doctor.asl at "container_h3";
        doctor_h3_general doctor.asl at "container_h3";
        equipment_manager_h3 equipment_manager.asl at "container_h3";

    aslSourcePath: "src/main/asl";
}
